{
  "name": "@referee/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signing, transcripts, sessions, channel codecs and native proving for referee games.",
  "exports": {
    ".": "./sdk/src/index.mjs",
    "./proving": "./sdk/src/proving.mjs",
    "./store": "./sdk/src/store.mjs",
    "./store/file": "./sdk/src/store-file.mjs"
  },
  "files": [
    "sdk/src"
  ],
  "scripts": {
    "fixtures": "node sdk/scripts/gen-counter-fixtures.mjs",
    "test": "node --test sdk/test/*.test.mjs prover/test/*.test.mjs",
    "prover": "node prover/server.mjs"
  },
  "dependencies": {
    "starknet": "10.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5"
  }
}
