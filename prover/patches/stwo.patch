+    fn polynomials<B: BackendForChannel<Blake2sMerkleChannel>>() -> Vec<CircleCoefficients<B>> {
+        // Deliberately unsorted, with equal-height columns whose stable order must be retained.
+        [6, 4, 7, 4]
+            .into_iter()
+            .enumerate()
+            .map(|(column, log_size)| {
+                CircleCoefficients::new(
+                    (0..1 << log_size)
+                        .map(|row| M31::from((row + column * 31) as u32))
+                        .collect(),
+                )
+            })
+            .collect()
+    }
+
+    fn check_recomputed_tree<B: BackendForChannel<Blake2sMerkleChannel>>() {
+        let twiddles = B::precompute_twiddles(CanonicCoset::new(9).half_coset());
+        let pool = BaseColumnPool::new();
+        let mut tree = CommitmentTreeProver::<B, Blake2sMerkleChannel>::new(
+            polynomials(),
+            1,
+            &twiddles,
+            true,
+            Some(9),
+            &pool,
+        );
+        let root = tree.commitment.root();
+        let query_sets = [vec![], vec![0], vec![1, 1, 3, 12, 511]];
+        let expected = query_sets.iter().map(|q| tree.decommit(q)).collect_vec();
+        tree.retain_merkle_root();
+        assert_eq!(tree.commitment.root(), root);
+        assert_eq!(tree.commitment.layers.len(), 10);
+        assert!(tree.commitment.layers.iter().skip(1).all(Column::is_empty));
+        for (queries, (values, extended)) in query_sets.iter().zip(expected) {
+            let (actual_values, actual) = tree.decommit(queries);
+            assert_eq!(actual_values, values);
+            assert_eq!(
+                actual.decommitment.hash_witness,
+                extended.decommitment.hash_witness
+            );
+            assert_eq!(actual.aux.all_node_values, extended.aux.all_node_values);
+            if !queries.is_empty() {
+                let verifier = MerkleVerifierLifted::new(root, vec![7, 5, 8, 5], Some(9));
+                verifier
+                    .verify(queries, actual_values.clone(), actual.decommitment.clone())
+                    .unwrap();
+                let mut corrupted = actual_values;
+                corrupted[0][0] += M31::from(1);
+                // Use a distinct query to keep this a Merkle rejection, not a duplicate-value
+                // consistency assertion in the verifier.
+                if queries.len() == 1 {
+                    assert!(verifier
+                        .verify(queries, corrupted, actual.decommitment)
+                        .is_err());
+                }
+            }
+        }
+
+        // A stale/mutated retained root must fail closed before returning an opening.
+        let old_root = tree.commitment.root();
+        tree.commitment.layers[0].set(0, Default::default());
+        assert_ne!(tree.commitment.root(), old_root);
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| tree.decommit(&[0]))).is_err()
+        );
+
+        let mut empty = CommitmentTreeProver::<B, Blake2sMerkleChannel>::new(
+            vec![],
+            1,
+            &twiddles,
+            true,
+            Some(0),
+            &pool,
+        );
+        let expected = empty.decommit(&[]);
+        empty.retain_merkle_root();
+        assert_eq!(empty.commitment.layers.len(), 1);
+        let actual = empty.decommit(&[]);
+        assert_eq!(expected.0, actual.0);
+        assert_eq!(
+            expected.1.decommitment.hash_witness,
+            actual.1.decommitment.hash_witness
+        );
+        assert_eq!(expected.1.aux.all_node_values, actual.1.aux.all_node_values);
+    }
+
+    fn check_pcs<B: BackendForChannel<Blake2sMerkleChannel>>(store_coeffs: bool, borrowed: bool) {
+        let config = PcsConfig::default(); // Test-only parameters, identical in both modes.
+        let twiddles = B::precompute_twiddles(CanonicCoset::new(8).half_coset());
+        let pool = BaseColumnPool::new();
+        let make_tree = || {
+            CommitmentTreeProver::<B, Blake2sMerkleChannel>::new(
+                polynomials(),
+                1,
+                &twiddles,
+                store_coeffs,
+                None,
+                &pool,
+            )
+        };
+        let cached = make_tree();
+        let original_layers = cached
+            .commitment
+            .layers
+            .iter()
+            .map(Column::to_cpu)
+            .collect_vec();
+        let sampled_points = TreeVec(vec![vec![vec![SECURE_FIELD_CIRCLE_GEN]; 4]; 2]);
+        let prove = |low_memory_mode| {
+            let mut scheme =
+                CommitmentSchemeProver::<B, Blake2sMerkleChannel>::new(config, &twiddles);
+            if store_coeffs {
+                scheme.set_store_polynomials_coefficients();
+            }
+            if low_memory_mode {
+                scheme.set_low_memory_mode();
+            }
+            let mut channel = Blake2sChannel::default();
+            scheme.commit_tree(
+                if borrowed {
+                    MaybeOwned::Borrowed(&cached)
+                } else {
+                    MaybeOwned::Owned(make_tree())
+                },
+                &mut channel,
+            );
+            let mut builder = scheme.tree_builder();
+            builder.extend_polys(polynomials());
+            builder.commit(&mut channel);
+            if low_memory_mode {
+                assert_eq!(scheme.trees[0].recompute_merkle_decommitment, !borrowed);
+                assert!(scheme.trees[1].recompute_merkle_decommitment);
+            }
+            scheme.prove_values(sampled_points.clone(), &mut channel)
+        };
+        let full = prove(false);
+        let reduced = prove(true);
+        // The proof has ordered vectors only; debug equality compares every proof field without
+        // adding a serialization dependency. End-to-end callers additionally compare bytes.
+        assert_eq!(format!("{:?}", full.proof), format!("{:?}", reduced.proof));
+        assert_eq!(
+            full.aux.unsorted_query_locations,
+            reduced.aux.unsorted_query_locations
+        );
+        for (left, right) in full
+            .aux
+            .trace_decommitment
+            .iter()
+            .zip(reduced.aux.trace_decommitment.iter())
+        {
+            assert_eq!(left.all_node_values, right.all_node_values);
+        }
+        assert_eq!(
+            cached
+                .commitment
+                .layers
+                .iter()
+                .map(Column::to_cpu)
+                .collect_vec(),
+            original_layers
+        );
+        assert!(cached
+            .polynomials
+            .iter()
+            .all(|poly| poly.coeffs.is_some() == store_coeffs));
+
+        let verify = |proof: CommitmentSchemeProof<_>| {
+            let mut channel = Blake2sChannel::default();
+            let mut verifier = CommitmentSchemeVerifier::<Blake2sMerkleChannel>::new(config);
+            for root in &proof.commitments.0 {
+                verifier.commit(*root, &[6, 4, 7, 4], &mut channel);
+            }
+            verifier.verify_values(sampled_points.clone(), proof, &mut channel)
+        };
+        verify(reduced.proof.clone()).unwrap();
+        let mut corrupted = reduced.proof;
+        corrupted.sampled_values[0][0][0] += SecureField::from(1);
+        assert!(verify(corrupted).is_err());
+    }
+
+    fn check_bounded_pcs<B: BackendForChannel<Blake2sMerkleChannel>>() {
+        let config = PcsConfig::default();
+        let twiddles = B::precompute_twiddles(CanonicCoset::new(8).half_coset());
+        let pool = BaseColumnPool::new();
+        let sampled_points = TreeVec(vec![
+            vec![
+                vec![],
+                vec![SECURE_FIELD_CIRCLE_GEN],
+                vec![SECURE_FIELD_CIRCLE_GEN; 2],
+                vec![SECURE_FIELD_CIRCLE_GEN],
+            ],
+            vec![vec![SECURE_FIELD_CIRCLE_GEN]; 4],
+        ]);
+        for borrowed in [false, true] {
+            for cache_coefficients in [false, true] {
+                let cached = CommitmentTreeProver::<B, Blake2sMerkleChannel>::new(
+                    polynomials(),
+                    1,
+                    &twiddles,
+                    cache_coefficients,
+                    None,
+                    &pool,
+                );
+                let cached_root = cached.commitment.root();
+                let prove = |max_columns: Option<usize>| {
+                    let mut scheme =
+                        CommitmentSchemeProver::<B, Blake2sMerkleChannel>::new(config, &twiddles);
+                    scheme.set_store_polynomials_coefficients();
+                    if let Some(max_columns) = max_columns {
+                        scheme.set_bounded_memory_mode(max_columns);
+                    }
+                    let mut channel = Blake2sChannel::default();
+                    scheme.commit_tree(
+                        if borrowed {
+                            MaybeOwned::Borrowed(&cached)
+                        } else {
+                            MaybeOwned::Owned(CommitmentTreeProver::new(
+                                polynomials(),
+                                1,
+                                &twiddles,
+                                true,
+                                None,
+                                &pool,
+                            ))
+                        },
+                        &mut channel,
+                    );
+                    let mut builder = scheme.tree_builder();
+                    builder.extend_polys(polynomials());
+                    builder.commit(&mut channel);
+                    if max_columns.is_some() {
+                        assert!(scheme.trees[1]
+                            .polynomials
+                            .iter()
+                            .all(|poly| poly.evals.is_none() && poly.coeffs.is_some()));
+                        assert!(scheme.trees[0]
+                            .polynomials
+                            .iter()
+                            .all(|poly| poly.evals.is_some() == borrowed));
+                    }
+                    scheme.prove_values(sampled_points.clone(), &mut channel)
+                };
+                let baseline = prove(None);
+                for max_columns in [1, 3, 16] {
+                    let bounded = prove(Some(max_columns));
+                    assert_eq!(
+                        format!("{:?}", baseline.proof),
+                        format!("{:?}", bounded.proof)
+                    );
+                    assert_eq!(
+                        baseline.aux.unsorted_query_locations,
+                        bounded.aux.unsorted_query_locations
+                    );
+                    for (left, right) in baseline
+                        .aux
+                        .trace_decommitment
+                        .iter()
+                        .zip(&bounded.aux.trace_decommitment.0)
+                    {
+                        assert_eq!(left.all_node_values, right.all_node_values);
+                    }
+                    let verify = |proof: CommitmentSchemeProof<_>| {
+                        let mut channel = Blake2sChannel::default();
+                        let mut verifier =
+                            CommitmentSchemeVerifier::<Blake2sMerkleChannel>::new(config);
+                        for root in &proof.commitments.0 {
+                            verifier.commit(*root, &[6, 4, 7, 4], &mut channel);
+                        }
+                        verifier.verify_values(sampled_points.clone(), proof, &mut channel)
+                    };
+                    verify(bounded.proof.clone()).unwrap();
+                    let mut bad_sample = bounded.proof.clone();
+                    bad_sample.sampled_values[0][1][0] += SecureField::from(1);
+                    assert!(verify(bad_sample).is_err());
+                    let mut bad_opening = bounded.proof;
+                    bad_opening.queried_values[0][0][0] += BaseField::from(1);
+                    assert!(verify(bad_opening).is_err());
+                }
+                assert_eq!(cached.commitment.root(), cached_root);
+                assert!(cached.polynomials.iter().all(
+                    |poly| poly.evals.is_some() && poly.coeffs.is_some() == cache_coefficients
+                ));
+            }
+        }
+    }
+
+    #[test]
+    fn bounded_pcs_cpu() {
+        check_bounded_pcs::<CpuBackend>();
+    }
+
+    #[test]
+    fn bounded_pcs_simd() {
+        check_bounded_pcs::<SimdBackend>();
+    }
+
+    #[test]
+    fn low_memory_tree_cpu() {
+        check_recomputed_tree::<CpuBackend>();
+    }
+
+    #[test]
+    fn low_memory_tree_simd() {
+        check_recomputed_tree::<SimdBackend>();
+    }
+
+    #[test]
+    fn low_memory_pcs_cpu() {
+        for store_coeffs in [false, true] {
+            for borrowed in [false, true] {
+                check_pcs::<CpuBackend>(store_coeffs, borrowed);
+            }
+        }
+    }
+
+    #[test]
+    fn low_memory_pcs_simd() {
+        for store_coeffs in [false, true] {
+            for borrowed in [false, true] {
+                check_pcs::<SimdBackend>(store_coeffs, borrowed);
+            }
+        }
+    }
+}
