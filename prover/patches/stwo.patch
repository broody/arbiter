+    /// Recreates a prefix of the committed bit-reversed evaluation vector. A requested domain
+    /// smaller than the coefficient vector is handled by evaluating on the full committed
+    /// domain first; coefficients are never truncated to fit a smaller FFT.
+    pub fn get_evaluation_on_prefix(
+        &self,
+        domain: CircleDomain,
+        twiddles: &TwiddleTree<B>,
+    ) -> CircleEvaluation<B, BaseField, BitReversedOrder> {
+        let log_split = self
+            .committed_domain
+            .log_size()
+            .checked_sub(domain.log_size())
+            .expect("Requested prefix exceeds the committed domain");
