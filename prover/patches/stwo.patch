+#[cfg(test)]
+mod bounded_tests {
+    use super::*;
+    use crate::prover::backend::simd::SimdBackend;
+    use crate::prover::backend::CpuBackend;
+
+    fn check_prefixes<B: Backend>() {
+        for coeff_log_size in [3, 5, 8] {
+            for blowup in [0, 1, 3] {
+                for kind in 0..3 {
+                    let coeffs = CircleCoefficients::<B>::new(
+                        (0..1 << coeff_log_size)
+                            .map(|i| {
+                                BaseField::from(match kind {
+                                    0 => 0,
+                                    1 => {
+                                        if i == 0 {
+                                            7
+                                        } else {
+                                            0
+                                        }
+                                    }
+                                    _ => (i * 17 + 5) as u32,
+                                })
+                            })
+                            .collect(),
+                    );
+                    let domain =
+                        crate::core::poly::circle::CanonicCoset::new(coeff_log_size + blowup)
+                            .circle_domain();
+                    let full = coeffs.evaluate(domain);
+                    let expected = full.values.to_cpu();
+                    let mut poly = Poly::new(Some(coeffs), full);
+                    poly.evict_evaluations();
+                    for prefix_log_size in 1..=domain.log_size() {
+                        let prefix = domain.split(domain.log_size() - prefix_log_size).0;
+                        let twiddles = B::precompute_twiddles(prefix.half_coset);
+                        let actual = poly.get_evaluation_on_prefix(prefix, &twiddles);
+                        assert_eq!(actual.domain, prefix);
+                        assert_eq!(actual.values.to_cpu(), expected[..prefix.size()]);
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn bounded_prefixes_cpu() {
+        check_prefixes::<CpuBackend>();
+    }
+
+    #[test]
+    fn bounded_prefixes_simd() {
+        check_prefixes::<SimdBackend>();
+    }
+}
