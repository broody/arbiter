+    fn build_leaves_with_column_provider(
+        column_log_sizes: &[u32],
+        lifting_log_size: u32,
+        mut get_columns: impl FnMut(&[usize]) -> Vec<BaseColumn>,
+    ) -> Vec<Blake2sHash> {
+        if column_log_sizes.is_empty() {
+            return vec![Blake2sMerkleHasherGeneric::<IS_M31_OUTPUT>::default().finalize()];
+        }
+        assert!(column_log_sizes
+            .iter()
+            .all(|&log_size| log_size > 0 && log_size <= lifting_log_size));
+        let mut indices: Vec<usize> = (0..column_log_sizes.len()).collect();
+        indices.sort_by_key(|&index| column_log_sizes[index]);
+
+        // A packed state contains 16 independent leaf hash states. Grow only when the next
+        // column block needs more rows, then reuse that buffer for blocks of the same height.
+        // Below 16 rows the extra lanes repeat the logical domain and are discarded at output.
+        let mut state_log_size = lifting_log_size.min(LOG_N_LANES);
+        let mut states = vec![INITIAL_STATE];
+        let mut byte_count = 0_u64;
+        for (block_index, block_indices) in indices.chunks(N_FELTS_IN_BLAKE_MESSAGE).enumerate() {
+            let columns = get_columns(block_indices);
+            assert_eq!(columns.len(), block_indices.len());
+            for (column, &index) in columns.iter().zip(block_indices) {
+                assert_eq!(column.len(), 1 << column_log_sizes[index]);
+            }
+            let next_log_size =
+                state_log_size.max(column_log_sizes[*block_indices.last().unwrap()]);
+            if next_log_size > state_log_size {
+                let log_ratio = next_log_size - state_log_size;
+                states = (0..1 << (next_log_size - LOG_N_LANES))
+                    .map(|i| {
+                        array::from_fn(|j| to_lifted_simd(states[i >> log_ratio][j], log_ratio, i))
+                    })
+                    .collect();
+                state_log_size = next_log_size;
+            }
+            byte_count += (columns.len() * N_BYTES_FELT) as u64;
+            let final_block = (block_index + 1) * N_FELTS_IN_BLAKE_MESSAGE >= indices.len();
+            #[cfg(not(feature = "parallel"))]
+            let iter = states.iter_mut();
+            #[cfg(feature = "parallel")]
