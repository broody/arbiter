+    fn check_component_columns<B: Backend>() {
+        // Mixed committed heights deliberately exercise the per-column prefix fallback;
+        // small requested domains also exercise prefixes shorter than the coefficient vector.
+        let coefficients = [3, 4, 6]
+            .into_iter()
+            .map(|log_size| {
+                CircleCoefficients::<B>::new(
+                    (0..1 << log_size)
+                        .map(|row| BaseField::from((row * 11 + 7) as u32))
+                        .collect(),
+                )
+            })
+            .collect_vec();
+        let mut polynomials = coefficients
+            .into_iter()
+            .map(|coefficients| {
+                let domain = CanonicCoset::new(coefficients.log_size() + 3).circle_domain();
+                let evaluations = coefficients.evaluate(domain);
+                Poly::new(Some(coefficients), evaluations)
+            })
+            .collect_vec();
+        for eval_log_size in [2, 4, 6] {
+            let eval_domain = subdomain_eval_domain(eval_log_size, 2);
+            let expected = {
+                let refs = polynomials.iter().collect_vec();
+                let columns = get_trace_columns(
