+                        make(&sizes), log_blowup, &twiddles, lifting,
+                    ),
+                    CommitmentTreeProver::<B, Blake2sMerkleChannel>::new_streamed(
+                        make(&sizes), log_blowup, &twiddles, lifting,
+                    ),
+                ] {
+                    let expected_layers =
+                        expected.commitment.layers.iter().map(Column::to_cpu).collect_vec();
+                    let layers = striped.commitment.layers.iter().map(Column::to_cpu).collect_vec();
+                    assert_eq!(layers, expected_layers, "blowup {log_blowup}, lifting {lifting:?}");
+                    let queries = [0, 1, 5, 77, (1 << (layers.len() - 1)) - 1];
+                    let (values, opening) = striped.open(&queries);
+                    let (expected_values, expected_opening) = expected.decommit(&queries);
