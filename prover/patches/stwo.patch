+                        &mut existing.partial_numerators_acc,
+                        &acc.partial_numerators_acc,
+                    );
+                    existing.first_linear_term_acc += acc.first_linear_term_acc;
+                } else {
+                    per_size.push(acc);
+                }
+            }
+        }
+        accumulated_numerators_vec.extend(per_size);
+    }
+    combine_accumulated_numerators(
+        accumulated_numerators_vec,
+        lifting_log_size,
+        log_blowup_factor,
+        twiddles,
+    )
+}
