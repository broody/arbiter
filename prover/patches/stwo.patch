+/// Computes the same DEEP quotients as `compute_fri_quotients` without retaining all expanded
+/// columns. Random powers and periodicity samples are assigned once in the original tree/column
+/// order, before any grouping or chunking. Each regenerated column contains exactly the prefix
+/// subdomain read by the cached implementation.
+pub fn compute_fri_quotients_bounded<B: Backend>(
+    polynomials: &TreeVec<Vec<&Poly<B>>>,
+    samples: &TreeVec<Vec<Vec<PointSample>>>,
+    random_coeff: SecureField,
+    lifting_log_size: u32,
+    twiddles: &TwiddleTree<B>,
+    log_blowup_factor: u32,
+    max_columns: usize,
+) -> SecureEvaluation<B, BitReversedOrder> {
+    assert!(max_columns > 0, "FRI batch size must be positive");
+    let _span = span!(
+        Level::INFO,
+        "Compute bounded FRI quotients",
+        class = "FRIQuotients"
+    )
+    .entered();
+    let samples_with_randomness = build_samples_with_randomness_and_periodicity(
+        samples,
+        polynomials
+            .iter()
+            .map(|tree| tree.iter().map(|p| p.committed_domain.log_size()))
+            .collect(),
+        lifting_log_size,
+        random_coeff,
+    );
+    let mut accumulated_numerators_vec = Vec::new();
+    let grouped = zip(
+        polynomials.iter().flatten(),
+        samples_with_randomness.iter().flatten(),
+    )
+    .sorted_by_key(|(poly, _)| poly.committed_domain.log_size())
+    .group_by(|(poly, _)| poly.committed_domain.log_size());
+    for (_, columns_and_samples) in &grouped {
+        let columns_and_samples = columns_and_samples.collect_vec();
+        let subdomain = columns_and_samples[0]
+            .0
+            .committed_domain
+            .split(log_blowup_factor)
+            .0;
+        let subdomain_twiddles = B::precompute_twiddles(subdomain.half_coset);
+        let mut per_size: Vec<AccumulatedNumerators<B>> = Vec::new();
+        for chunk in columns_and_samples.chunks(max_columns) {
+            let evaluate = |(poly, _): &(&&Poly<B>, &Vec<(PointSample, SecureField)>)| {
+                    let domain = poly.committed_domain.split(log_blowup_factor).0;
+                    if let Some(evals) = &poly.evals {
+                        // Borrowed preprocessed trees may not retain coefficients. Copy only the
+                        // prefix needed by numerator accumulation rather than extending anything.
+                        CircleEvaluation::new(
+                            domain,
+                            (0..domain.size()).map(|row| evals.values.at(row)).collect(),
+                        )
+                    } else {
+                        assert_eq!(domain, subdomain);
+                        poly.get_evaluation_on_prefix(domain, &subdomain_twiddles)
+                    }
+            };
+            // A chunk's columns are evaluated together: one at a time leaves most threads idle.
+            #[cfg(not(feature = "parallel"))]
+            let evaluations = chunk.iter().map(evaluate).collect_vec();
+            #[cfg(feature = "parallel")]
+            let evaluations: Vec<_> = {
+                use rayon::prelude::*;
+                chunk.par_iter().map(evaluate).collect()
+            };
+            let sample_refs = chunk.iter().map(|(_, samples)| *samples).collect_vec();
+            let sample_batches = ColumnSampleBatch::new_vec(&sample_refs);
+            let mut chunk_acc = Vec::new();
+            B::accumulate_numerators(
+                &evaluations.iter().collect_vec(),
+                &sample_batches,
+                &mut chunk_acc,
+                0,
+            );
+            // Merge equal-size sums before the original cross-size lifting step. Every random
+            // power has already been assigned globally; no power is restarted at a chunk edge.
+            for acc in chunk_acc {
