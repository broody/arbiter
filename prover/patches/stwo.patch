+/// Reads one packed message with the same pair-preserving lift as the ordinary commitment.
+fn streamed_column_message(
+    column: &BaseColumn,
+    column_log_size: u32,
+    logical_log_size: u32,
+    packed_row: usize,
+) -> u32x16 {
+    let log_ratio = logical_log_size - column_log_size;
+    if column_log_size >= LOG_N_LANES {
+        to_lifted_simd(
+            column.data[packed_row >> log_ratio].into_simd(),
+            log_ratio,
+            packed_row,
+        )
+    } else {
+        u32x16::from_array(array::from_fn(|lane| {
+            let row = (packed_row * N_LANES + lane) % (1 << logical_log_size);
+            // Preserve the raw field representation exactly as the ordinary CPU fallback's
+            // `to_cpu` does. `Column::at` would canonicalize the packed representation of zero.
+            column.as_slice()[(row >> (log_ratio + 1) << 1) + (row & 1)].0
+        }))
+    }
+}
