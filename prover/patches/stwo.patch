+    /// provider. This method does not pack FRI leaves.
+    fn build_leaves_with_column_provider(
+        column_log_sizes: &[u32],
+        lifting_log_size: u32,
+        mut get_columns: impl FnMut(&[usize]) -> Vec<Col<Self, BaseField>>,
+    ) -> Col<Self, H::Hash> {
+        if column_log_sizes.is_empty() {
+            return Self::build_leaves(&[], lifting_log_size);
+        }
+        assert!(column_log_sizes
+            .iter()
+            .all(|&log_size| log_size > 0 && log_size <= lifting_log_size));
+        let mut indices: Vec<usize> = (0..column_log_sizes.len()).collect();
+        indices.sort_by_key(|&index| column_log_sizes[index]);
+        let columns = get_columns(&indices);
+        assert_eq!(columns.len(), indices.len());
+        for (column, &index) in columns.iter().zip(&indices) {
+            assert_eq!(column.len(), 1 << column_log_sizes[index]);
+        }
+        Self::build_leaves(&columns.iter().collect::<Vec<_>>(), lifting_log_size)
+    }
