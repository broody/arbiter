+    /// The evaluations of `poly` on stripe `stripe` of `domain`: the `stripe`-th of the blocks of
+    /// `poly`'s size into which [`Self::evaluate`]'s bit-reversed output on `domain` divides. In
+    /// bit-reversed order such a block is the evaluation on a coset of `poly`'s size.
+    fn evaluate_stripe(
+        poly: &CircleCoefficients<Self>,
+        domain: CircleDomain,
+        stripe: usize,
+        twiddles: &TwiddleTree<Self>,
+    ) -> Col<Self, BaseField> {
+        let values = Self::evaluate(poly, domain, twiddles).values.to_cpu();
+        let size = 1 << poly.log_size();
+        values[stripe * size..(stripe + 1) * size].iter().copied().collect()
+    }
