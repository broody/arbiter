+                .iter_mut()
+                .map(|poly| poly.evals.take())
+                .collect_vec();
+            let refs = polynomials.iter().collect_vec();
+            let columns = get_trace_columns(
+                TreeVec(vec![refs.iter().collect()]),
+                eval_domain,
+                EvaluationMode::SubDomain { log_expansion: 2 },
+            );
+            assert_eq!(
+                columns[0]
+                    .iter()
+                    .map(|column| column.values.to_cpu())
+                    .collect_vec(),
+                expected
+            );
+            drop(columns);
+            for (poly, evaluations) in polynomials.iter_mut().zip(cached) {
+                poly.evals = evaluations;
+            }
+        }
+        // ExtendToEvalDomain must continue to evaluate the same polynomial, irrespective of
+        // whether the committed LDE happens to be retained.
+        let eval_domain = CanonicCoset::new(8).circle_domain();
+        let expected = {
+            let refs = polynomials.iter().collect_vec();
+            get_trace_columns(
+                TreeVec(vec![refs.iter().collect()]),
+                eval_domain,
+                EvaluationMode::ExtendToEvalDomain,
+            )[0]
+            .iter()
+            .map(|column| column.values.to_cpu())
+            .collect_vec()
+        };
+        polynomials.iter_mut().for_each(Poly::evict_evaluations);
+        let refs = polynomials.iter().collect_vec();
+        let actual = get_trace_columns(
+            TreeVec(vec![refs.iter().collect()]),
+            eval_domain,
+            EvaluationMode::ExtendToEvalDomain,
+        );
+        assert_eq!(
+            actual[0]
+                .iter()
+                .map(|column| column.values.to_cpu())
+                .collect_vec(),
+            expected
+        );
+    }
