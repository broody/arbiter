+
+/// Proves a Cairo PIE on the current thread with `privacy_recursive_prove` (or its low-memory
+/// variant).
+///
+/// With `PROVER_PIE_DUMP=DIR`, the PIE is first written to `DIR` as a zip, so the proof can be
+/// repeated offline with the `prove_pie` binary, without the node. With `PROVER_MALLOC_TRIM=1`,
+/// glibc returns the proof's freed memory to the system once the proof is done.
+pub fn prove_blocking(
+    cairo_pie: CairoPie,
+    precomputes: &RecursiveProverPrecomputes,
+) -> Result<ProverOutput, ProvingError> {
+    if let Some(dir) = std::env::var_os("PROVER_PIE_DUMP") {
+        dump_pie(&cairo_pie, std::path::Path::new(&dir));
+    }
+    let proof_output = match precomputes {
+        RecursiveProverPrecomputes::Cached(shared) => {
+            privacy_recursive_prove(cairo_pie, shared.clone())
+        }
+        RecursiveProverPrecomputes::LowMemory(options) => {
+            privacy_recursive_prove_low_memory(cairo_pie, *options)
+        }
+    }
+    .map_err(|e| ProvingError::ProverExecution(e.to_string()));
+    #[cfg(target_env = "gnu")]
+    if std::env::var_os("PROVER_MALLOC_TRIM").is_some_and(|value| value == "1") {
+        // SAFETY: malloc_trim only releases free heap memory.
+        unsafe { libc::malloc_trim(0) };
+    }
+    let proof_output = proof_output?;
 
     let proof = Proof::from(proof_output.proof);
     let program_output = ProgramOutput::from(proof_output.output_preimage);
 
     Ok(ProverOutput { proof, program_output })
 }
+
+fn dump_pie(cairo_pie: &CairoPie, dir: &std::path::Path) {
+    let millis = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis())
+        .unwrap_or_default();
+    let path = dir.join(format!("pie-{millis}-{}.zip", cairo_pie.execution_resources.n_steps));
+    match std::fs::create_dir_all(dir).and_then(|()| cairo_pie.write_zip_file(&path, false)) {
+        Ok(()) => info!("Cairo PIE written to {}", path.display()),
+        Err(error) => tracing::warn!("Cairo PIE not written to {}: {error}", path.display()),
+    }
+}
