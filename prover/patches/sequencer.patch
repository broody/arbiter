index a6f457f..c5da847 100644
--- a/crates/starknet_transaction_prover/src/proving/prover.rs
+++ b/crates/starknet_transaction_prover/src/proving/prover.rs
@@ -5,15 +5,82 @@
 use std::sync::Arc;
 
 use cairo_vm::vm::runners::cairo_pie::CairoPie;
-use privacy_prove::{privacy_recursive_prove, RecursiveProverPrecomputes};
+use privacy_prove::{privacy_recursive_prove, privacy_recursive_prove_low_memory, LowMemoryOptions};
 use starknet_api::transaction::fields::Proof;
 use starknet_proof_verifier::ProgramOutput;
+use tracing::info;
 
 use crate::errors::ProvingError;
 
+/// What the prover keeps between and during proofs, chosen once at startup from the
+/// environment. Every mode produces the same proof bytes; only memory and time differ.
+///
+/// - `PROVER_LOW_MEMORY=1`: no precomputes stay resident. Each proof builds its preprocessed
+///   trees, and each stage (Cairo, then the recursive circuit) releases its tree and buffer
+///   pool before the next starts.
+///   - `PROVER_RECOMPUTE_CAIRO_COMMITMENTS` (default 1): keep only Merkle roots and rebuild a
+///     tree when opening it.
+///   - `PROVER_CAIRO_COEFFICIENTS` (default 1): keep Cairo polynomial coefficients.
+///   - `PROVER_BOUNDED_CAIRO_COLUMNS`, `PROVER_BOUNDED_CIRCUIT_COLUMNS` (default 0, off): for
+///     `N > 0`, keep coefficients instead of expanded evaluations and compute FRI quotients
+///     `N` columns at a time.
+/// - Otherwise (default): upstream behavior, with precomputes built once and shared.
+pub enum RecursiveProverPrecomputes {
+    Cached(Arc<privacy_prove::RecursiveProverPrecomputes>),
+    LowMemory(LowMemoryOptions),
+}
+
+pub fn prepare_recursive_prover_precomputes()
+-> Result<Arc<RecursiveProverPrecomputes>, Box<dyn std::error::Error>> {
+    let flag = |name: &str, default: bool| -> Result<bool, Box<dyn std::error::Error>> {
+        match std::env::var(name).as_deref() {
+            Ok("0") => Ok(false),
+            Ok("1") => Ok(true),
+            Err(std::env::VarError::NotPresent) => Ok(default),
+            _ => Err(format!("{name} must be 0 or 1").into()),
+        }
+    };
+    let columns = |name: &str| -> Result<Option<usize>, Box<dyn std::error::Error>> {
+        let value = match std::env::var(name) {
+            Ok(value) => {
+                value.parse::<usize>().map_err(|_| format!("{name} must be a nonnegative integer"))?
+            }
+            Err(std::env::VarError::NotPresent) => 0,
+            Err(error) => return Err(error.into()),
+        };
+        Ok((value > 0).then_some(value))
+    };
+    let bounded_cairo_columns = columns("PROVER_BOUNDED_CAIRO_COLUMNS")?;
+    let bounded_circuit_columns = columns("PROVER_BOUNDED_CIRCUIT_COLUMNS")?;
+    if !flag("PROVER_LOW_MEMORY", false)? {
+        if bounded_cairo_columns.is_some() || bounded_circuit_columns.is_some() {
+            return Err("PROVER_BOUNDED_*_COLUMNS require PROVER_LOW_MEMORY=1".into());
+        }
+        info!("Prover memory mode: cached precomputes");
+        return Ok(Arc::new(RecursiveProverPrecomputes::Cached(
+            privacy_prove::prepare_recursive_prover_precomputes()?,
+        )));
+    }
+    let options = LowMemoryOptions {
+        cache_cairo_coefficients: flag("PROVER_CAIRO_COEFFICIENTS", true)?,
+        recompute_cairo_commitments: flag("PROVER_RECOMPUTE_CAIRO_COMMITMENTS", true)?,
+        bounded_cairo_columns,
+        bounded_circuit_columns,
+    };
+    info!(
+        "Prover memory mode: low memory (cairo coefficients {}, recompute cairo commitments {}, \
+         bounded cairo columns {:?}, bounded circuit columns {:?})",
+        options.cache_cairo_coefficients,
+        options.recompute_cairo_commitments,
+        options.bounded_cairo_columns,
+        options.bounded_circuit_columns
+    );
+    Ok(Arc::new(RecursiveProverPrecomputes::LowMemory(options)))
+}
