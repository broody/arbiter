diff --git a/crates/starknet_transaction_prover/src/bin/prove_pie.rs b/crates/starknet_transaction_prover/src/bin/prove_pie.rs
new file mode 100644
index 0000000..718c7b7
--- /dev/null
+++ b/crates/starknet_transaction_prover/src/bin/prove_pie.rs
@@ -0,0 +1,139 @@
+//! Proves Cairo PIEs dumped by the backend (`PROVER_PIE_DUMP`) offline, as the backend proves
+//! them, and prints one JSON line per proof on stdout: proof and facts hashes for identity
+//! checks, time and peak memory. No node is needed, so a recorded settlement can be proved again
+//! long after its block has left the node's storage-proof window.
+//!
+//!   prove_pie [--repeat N] PIE.zip...
+//!
+//! The memory mode comes from the backend's environment variables (`PROVER_LOW_MEMORY` and the
+//! rest). Each tracing line on stderr starts with the process's resident and peak memory in MiB,
+//! so the log also shows which proving phase sets the peak; `PROVE_PIE_LOG` (an `EnvFilter`)
+//! adds the prover crates' spans, e.g. `info,stwo=info,stwo_cairo_prover=info`. The peak is reset
+//! before each proof.
+
+use std::path::PathBuf;
+use std::time::Instant;
+
+use cairo_vm::vm::runners::cairo_pie::CairoPie;
+use sha2::{Digest, Sha256};
+use starknet_api::transaction::fields::VIRTUAL_SNOS;
+use starknet_transaction_prover::proving::prover::{
+    prepare_recursive_prover_precomputes,
+    prove_blocking,
+};
+use tracing::field::{Field, Visit};
+use tracing_subscriber::layer::{Context, SubscriberExt};
+use tracing_subscriber::registry::LookupSpan;
+use tracing_subscriber::util::SubscriberInitExt;
+use tracing_subscriber::{EnvFilter, Layer};
+
+/// `(VmRSS, VmHWM)` in MiB.
+fn memory_mib() -> (u64, u64) {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let field = |name: &str| {
+        status
+            .lines()
+            .find_map(|line| line.strip_prefix(name))
+            .and_then(|rest| rest.split_whitespace().next()?.parse::<u64>().ok())
+            .map_or(0, |kib| kib / 1024)
+    };
+    (field("VmRSS:"), field("VmHWM:"))
+}
+
+fn reset_peak() {
+    // Writing 5 to clear_refs resets VmHWM to the current resident size.
+    let _ = std::fs::write("/proc/self/clear_refs", "5");
+}
+
+struct MemoryLayer {
+    start: Instant,
+}
+
+impl MemoryLayer {
+    fn line(&self, target: &str, text: &str) {
+        let (rss, hwm) = memory_mib();
+        eprintln!("{:8.3}s [rss {rss} hwm {hwm}] {target}: {text}", self.start.elapsed().as_secs_f64());
+    }
+}
+
+impl<S: tracing::Subscriber + for<'a> LookupSpan<'a>> Layer<S> for MemoryLayer {
+    fn on_enter(&self, id: &tracing::span::Id, ctx: Context<'_, S>) {
+        if let Some(span) = ctx.span(id) {
+            self.line(span.metadata().target(), &format!("> {}", span.name()));
+        }
+    }
+
+    fn on_event(&self, event: &tracing::Event<'_>, _ctx: Context<'_, S>) {
+        struct Message(String);
+        impl Visit for Message {
+            fn record_debug(&mut self, field: &Field, value: &dyn std::fmt::Debug) {
+                if self.0.is_empty() || field.name() == "message" {
+                    self.0 = format!("{value:?}");
+                }
+            }
+        }
+        let mut message = Message(String::new());
+        event.record(&mut message);
+        self.line(event.metadata().target(), &message.0);
+    }
+}
+
+fn sha256_hex(bytes: impl AsRef<[u8]>) -> String {
+    hex::encode(Sha256::digest(bytes))
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut args = std::env::args().skip(1).peekable();
+    let mut repeat = 1;
+    if args.peek().map(String::as_str) == Some("--repeat") {
+        args.next();
+        repeat = args.next().ok_or("--repeat needs a count")?.parse()?;
+    }
+    let pies: Vec<PathBuf> = args.map(PathBuf::from).collect();
+    if pies.is_empty() {
+        return Err("usage: prove_pie [--repeat N] PIE.zip...".into());
+    }
+    tracing_subscriber::registry()
+        .with(
+            MemoryLayer { start: Instant::now() }
+                .with_filter(EnvFilter::new(std::env::var("PROVE_PIE_LOG").unwrap_or_else(|_| {
+                    "warn,starknet_transaction_prover=info,privacy_prove=info".into()
+                }))),
+        )
+        .init();
+
+    let started = Instant::now();
+    let precomputes = prepare_recursive_prover_precomputes()?;
+    let precompute_ms = started.elapsed().as_millis();
+
+    for round in 1..=repeat {
+        for path in &pies {
+            let pie = CairoPie::read_zip_file(path)?;
+            let n_steps = pie.execution_resources.n_steps;
+            reset_peak();
+            let started = Instant::now();
+            let output = prove_blocking(pie, &precomputes)?;
+            let prove_ms = started.elapsed().as_millis();
+            let (rss_mib, peak_mib) = memory_mib();
+            let facts = output.program_output.try_into_proof_facts(VIRTUAL_SNOS)?;
+            // The same hashes as the bench client's: the proof's base64 string and the facts as
+            // unprefixed lowercase hex in a JSON array.
+            let proof_base64 = serde_json::to_value(&output.proof)?;
+            let facts_hex: Vec<String> = facts.0.iter().map(|felt| format!("{felt:x}")).collect();
+            let row = serde_json::json!({
+                "pie": path.file_name().map(|name| name.to_string_lossy()),
+                "round": round,
+                "n_steps": n_steps,
+                "proof_bytes": output.proof.0.len(),
+                "proof_sha256": sha256_hex(proof_base64.as_str().unwrap_or_default()),
+                "facts_sha256": sha256_hex(serde_json::to_string(&facts_hex)?),
+                "prove_ms": prove_ms,
+                "precompute_ms": precompute_ms,
+                "peak_mib": peak_mib,
+                "rss_after_mib": rss_mib,
+            });
+            println!("{row}");
+        }
+    }
+    Ok(())
+}
