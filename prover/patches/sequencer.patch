-/// Calls `privacy_recursive_prove` with the CairoPie and precomputed data on a blocking thread.
+/// Calls `privacy_recursive_prove` (or its low-memory variant) with the CairoPie on a blocking
+/// thread.
 pub(crate) async fn prove(
     cairo_pie: CairoPie,
     precomputes: Arc<RecursiveProverPrecomputes>,
 ) -> Result<ProverOutput, ProvingError> {
     let proof_output = tokio::task::spawn_blocking(move || {
-        privacy_recursive_prove(cairo_pie, precomputes).map_err(|e| e.to_string())
+        match precomputes.as_ref() {
+            RecursiveProverPrecomputes::Cached(shared) => {
+                privacy_recursive_prove(cairo_pie, shared.clone())
+            }
+            RecursiveProverPrecomputes::LowMemory(options) => {
+                privacy_recursive_prove_low_memory(cairo_pie, *options)
+            }
+        }
+        .map_err(|e| e.to_string())
     })
     .await
     .map_err(ProvingError::TaskJoin)?
